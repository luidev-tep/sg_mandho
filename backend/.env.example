# Copiar este archivo a .env y completar con valores reales.
# Nunca commitear .env (esta en .gitignore).
SECRET_KEY=replace-with-python-secrets-token-hex-32
URL_FRONTEND=http://localhost:5173
FLASK_DEBUG=false

# reCAPTCHA v2 checkbox. En produccion: RECAPTCHA_ENABLED=true y colocar el secreto.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=

# ==============================================================================
# Perfil 1: Windows SQL Server Express Local (por defecto)
# ==============================================================================
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=sg_mandho
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_CERT=yes
DB_TRUSTED_CONNECTION=yes
DB_CONNECT_TIMEOUT=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ==============================================================================
# Perfil 2: Docker SQL Server Local (docker-compose.db.yml)
# ==============================================================================
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_SERVER=localhost,1433
# DB_NAME=sg_mandho
# DB_USER=sa
# DB_PASSWORD=MandhoDev2026!
# DB_ENCRYPT=no
# DB_TRUST_CERT=yes
# DB_TRUSTED_CONNECTION=no

# Azure Container Apps: identidad administrada asignada por el usuario.
# DB_AUTHENTICATION=ManagedIdentity
# AZURE_CLIENT_ID=<client-id-de-la-identidad>
# En este perfil no establecer DB_USER ni DB_PASSWORD.

# ==============================================================================
# Perfil 3: Azure SQL Database (Produccion / Demo Congreso)
# ==============================================================================
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_SERVER=<tu-servidor>.database.windows.net,1433
# DB_NAME=sg_mandho
# DB_USER=<tu-usuario-admin>
# DB_PASSWORD=<tu-password-segura>
# DB_ENCRYPT=yes
# DB_TRUST_CERT=no
# DB_TRUSTED_CONNECTION=no
